{
    "overrides": [
        {
            "files": "*.sol",
            "options": {
                "printWidth": 80,
                "tabWidth": 4,
                "useTabs": false,
                "singleQuote": false,
                "bracketSpacing": false
            }
        },
        {
            "files": "*.yml",
            "options": {}
        },
        {
            "files": "*.yaml",
            "options": {}
        },
        {
            "files": "*.toml",
            "options": {}
        },
        {
            "files": "*.json",
            "options": {}
        },
        {
            "files": "*.js",
            "options": {}
        },
        {
            "files": "*.ts",
            "options": {}
        },
        {
            "files": ["scripts/**/*.js", "scripts/**/*.cjs"],
            "options": {
                "printWidth": 100,
                "tabWidth": 2,
                "useTabs": false,
                "singleQuote": true,
                "semi": true,
                "trailingComma": "es5",
                "endOfLine": "auto"
            }
        }
    ]
}
